DATABASE_URL="file:./dev.db"

# Free LLM (pick one). OpenAI is optional and paid — not required.
# 1) Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 2) Google Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3) Ollama local — install from https://ollama.com then: ollama pull llama3.2
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Paid fallback only if you already have it
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Job search — Adzuna (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Email apply (optional). Without SMTP, applications stay queued.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Worker
SEARCH_CRON="0 */6 * * *"
